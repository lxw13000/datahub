# 正式环境查询后端。8002是常驻all实例，8003是部署期间临时query实例。
upstream es_server_query_backend {
    server 127.0.0.1:8002 max_fails=1 fail_timeout=5s;
    server 127.0.0.1:8003 backup max_fails=1 fail_timeout=5s;
    keepalive 32;
}

# 正式环境外部业务保持使用原域名和80端口。
server {
    client_max_body_size 200m;
    listen 80;
    server_name es-server.fofunlive.net;

    location / {
        proxy_pass http://es_server_query_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_redirect off;
    }
}

# 正式环境内部服务统一使用“服务器内网IP:8102”，与Docker后端8002/8003分离。
server {
    client_max_body_size 200m;
    listen 8102;
    server_name _;

    location / {
        proxy_pass http://es_server_query_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_redirect off;
    }
}

# 正式Elasticsearch外部代理；容器宿主机端口为9201。
server {
    client_max_body_size 200m;
    listen 80;
    server_name es.fofunlive.net;

    location / {
        proxy_pass http://127.0.0.1:9201;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_redirect off;
    }
}
